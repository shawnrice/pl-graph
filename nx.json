{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.@(ts|tsx)",
      "!{projectRoot}/vite.config.@(ts|js|mts|mjs)",
      "!{projectRoot}/build.ts"
    ],
    "sharedGlobals": [],
    "rustEngine": [
      "{workspaceRoot}/crates/lenke-engine/src/**/*",
      "{workspaceRoot}/crates/lenke-engine/Cargo.toml",
      "{workspaceRoot}/crates/lenke-engine-core/src/**/*",
      "{workspaceRoot}/crates/lenke-engine-core/Cargo.toml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "coverage": {
      "outputs": ["{projectRoot}/.coverage"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["build", "^build"],
      "//": "A package's tests import its workspace dependencies through their built dist/ (@lenke/* are externalized and resolved at runtime), so those must exist before a test runs. `^build` alone is not enough — nx can interleave the DAG and start a package's tests before a sibling dependency's dist/ is fully written. Depending on this package's own `build` too forces it and, transitively, its deps fully built before any of its tests run. Projects that also declare lenke-engine:build/build-wasm cover the Rust artifacts (loaded by path, invisible to the nx graph); this covers the JS side."
    }
  },
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "vite:build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vite:test"
      }
    }
  ],
  "analytics": false
}
