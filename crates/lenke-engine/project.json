{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lenke-engine",
  "projectType": "library",
  "sourceRoot": "crates/lenke-engine/src",
  "tags": ["rust"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --features capi",
        "cwd": "crates/lenke-engine"
      },
      "dependsOn": [],
      "outputs": ["{projectRoot}/target/release/liblenke_engine.so"],
      "cache": false
    },
    "build-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --target wasm32-unknown-unknown --no-default-features --features capi,codecs",
        "cwd": "crates/lenke-engine"
      },
      "inputs": ["rustEngine"],
      "outputs": ["{projectRoot}/target/wasm32-unknown-unknown/release/lenke_engine.wasm"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo test", "cwd": "crates/lenke-engine" },
      "inputs": ["rustEngine"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --all-targets -- -D warnings",
        "cwd": "crates/lenke-engine"
      },
      "inputs": ["rustEngine"],
      "cache": true
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fmt", "cwd": "crates/lenke-engine" },
      "cache": false
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo fmt --check", "cwd": "crates/lenke-engine" },
      "inputs": ["rustEngine"],
      "cache": true
    }
  }
}
